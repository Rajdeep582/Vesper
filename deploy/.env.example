# Server environment. Copy to deploy/.env for local runs (git-ignored). On Render set these in the dashboard.
MONGO_URI=mongodb://localhost:27017
MONGO_DB=vesper
JWT_SECRET=                 # ./gradlew :server:genSecret
HALL_DATA_KEYSET=           # ./gradlew :server:genKeyset
ADMIN_USERNAME=
ADMIN_PASSWORD_ARGON2=      # ./gradlew :server:hashPassword --args="hash <password>"
MEDIA_PROVIDER=cloudinary   # cloudinary | local (local only with VESPER_DEV=true)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=vesper/m
PUBLIC_BASE_URL=https://<service>.onrender.com
FCM_SERVICE_ACCOUNT_JSON_B64=   # optional: base64 of the Firebase service-account JSON
# PORT is injected by Render.
# Dev only:
VESPER_DEV=false
LOCAL_MEDIA_DIR=.dev/media
